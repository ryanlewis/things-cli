#!/bin/sh
printf 'osascript %s\n' "$*" >> "$SHIMLOG"
if [ -n "$SHIMAPPLY" ]; then
  id=$(printf '%s' "$2" | /usr/bin/sed -n 's/.* id "\([^"]*\)".*/\1/p')
  case "$2" in *"to completed"*) st=3;; *"to canceled"*) st=2;; *) exit 0;; esac
  # Today's local midnight: a close the app would still hold unlogged, and
  # the same value for both runs of a case.
  stop=$(/bin/date -j -v0H -v0M -v0S +%s)
  /usr/bin/sqlite3 "$SHIMDB" "UPDATE TMTask SET status=$st, stopDate=$stop, userModificationDate=$((stop + 1)) WHERE uuid='$id';"
fi
exit 0
